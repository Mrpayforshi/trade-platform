# Supabase project config — get real values from Tadiwa.
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Project API URL (Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe for client-side use, RLS enforces access control
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, bypasses RLS. Used in
# lib/supabase/server.ts (createServiceRoleClient) for admin-only writes
# like the transaction state-machine route. NEVER expose to the client
# or commit this value anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications) — used in lib/notifications/providers/email.ts
RESEND_API_KEY=
# Optional — falls back to a placeholder sender if unset. Set this once a
# real sending domain is verified in Resend.
RESEND_FROM_EMAIL=

# Twilio (WhatsApp notifications) — used in lib/notifications/providers/whatsapp.ts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. 'whatsapp:+14155238886' for the Twilio sandbox, or your approved
# WhatsApp Business sender once verified.
TWILIO_WHATSAPP_FROM=

# Secures /api/cron/send-notifications (see vercel.json) so only Vercel's
# cron trigger can call it. Vercel sets this automatically for you in
# Production — you only need to set it yourself for local testing.
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
